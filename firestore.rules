rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /schools/{schoolID} {
      allow read: if request.auth.token.admin == true ||
                     schoolID in request.auth.token.teacher;
      allow write: if request.auth.token.admin == true ||
                      schoolID in request.auth.token.teacher;
    }

    // TODO: update with proper rules
    match /problemsets/{problemset}/problems/{problem} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;

      match /translations/{translation} {
        allow read: if true;
        allow write: if request.auth.token.admin == true;
      }

      // TODO: this is not intended this way
      match /solutions/{language} {
        allow read: if true;
        allow write: if request.auth.token.admin == true;
      }
    }

    match /groups/{group} {
      allow read:  if request.auth.token.admin == true
                   || resource.data.schoolID in request.auth.token.teacher
                   || resource.data.schoolID in get(/databases/$(database)/documents/userdata/$(request.auth.uid)).data.schools;
      allow write: if request.auth.token.admin == true
                   || resource.data.schoolID in request.auth.token.teacher;

      match /classes/{class} {
        allow read:  if request.auth.token.admin == true
                     || get(/databases/$(database)/documents/groups/$(group)).data.schoolID in request.auth.token.teacher
                     || get(/databases/$(database)/documents/groups/$(group)).data.schoolID in get(/databases/$(database)/documents/userdata/$(request.auth.uid)).data.schools;
        allow write: if request.auth.token.admin == true
                     || get(/databases/$(database)/documents/groups/$(group)).data.schoolID in request.auth.token.teacher;
      }
    }

    match /userdata/{userId} {
      allow read:  if request.auth.token.admin == true
                   || resource.data.schools.hasAny(request.auth.token.teacher)
                   || request.auth.uid == userId;
      allow write: if request.auth.token.admin == true
                   || resource.data.schools.hasAny(request.auth.token.teacher);
    }
  }
}
